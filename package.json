{
  "name": "calwise",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --typescript",
    "dev": "vp run -r --parallel dev",
    "build": "vp run -r build",
    "test": "vp test",
    "e2e": "pnpm --filter @calwise/web e2e",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "check": "vp check",
    "typecheck": "vp run -r typecheck",
    "db:migrate:local": "pnpm --filter @calwise/api db:migrate:local"
  },
  "devDependencies": {
    "@effect/tsgo": "0.41.0",
    "@oxlint/plugins": "1.79.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@11.17.0"
}
