{
  "name": "calwise",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --typescript",
    "dev": "vp run -r --parallel dev",
    "build": "vp run -r build",
    "test": "vp test",
    "test:unit": "vp test --project unit",
    "test:integration": "vp test --project integration",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "check": "vp check",
    "typecheck": "vp run -r typecheck",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:push": "pnpm --filter @calwise/database db:push",
    "db:generate": "pnpm --filter @calwise/database db:generate",
    "db:migrate": "pnpm --filter @calwise/database db:migrate",
    "db:studio": "pnpm --filter @calwise/database db:studio"
  },
  "devDependencies": {
    "@effect/tsgo": "0.41.0",
    "@oxlint/plugins": "1.79.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@11.17.0"
}
