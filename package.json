{
  "name": "calwise",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --typescript",
    "dev": "pnpm db:migrate:local && vp run --filter '@calwise/*' --parallel dev",
    "build": "vp run -r build",
    "test": "playwright test",
    "test:integration": "playwright test",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "check": "vp check",
    "typecheck": "tsc -p tsconfig.tools.json && vp run --filter '@calwise/*' typecheck",
    "db:generate": "pnpm --filter @calwise/database db:generate",
    "db:migrate:local": "pnpm --filter @calwise/api db:migrate:local",
    "db:migrate:remote": "pnpm --filter @calwise/api db:migrate:remote",
    "cloudflare:config": "node tools/cloudflare-config.ts"
  },
  "devDependencies": {
    "@effect/tsgo": "0.41.0",
    "@oxlint/plugins": "1.79.0",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@11.17.0"
}
