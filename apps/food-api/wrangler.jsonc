{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "calwise-food-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-25",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "FOOD_DB",
      "database_name": "calwise-food",
      "migrations_dir": "../../packages/food-database/migrations",
      "migrations_pattern": "../../packages/food-database/migrations/*/migration.sql",
    },
  ],
}
