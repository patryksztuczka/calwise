{
  "name": "@calwise/api",
  "private": true,
  "type": "module",
  "exports": {
    "./trpc": "./src/trpc-router.ts"
  },
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc -p tsconfig.json",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config wrangler.production.json",
    "deploy": "wrangler deploy --config wrangler.production.json"
  },
  "dependencies": {
    "@calwise/database": "workspace:*",
    "@calwise/shared": "workspace:*",
    "@hono/trpc-server": "catalog:",
    "@trpc/server": "catalog:",
    "effect": "catalog:",
    "effect-cf": "catalog:",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  }
}
