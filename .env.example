# Reference for the environment variables currently used by the project.
# Local development needs no credentials. Never commit real secrets.
# To use this at the repo root, copy to .env, fill in what you need, then run:
#   set -a; . ./.env; set +a
# The root .env is not loaded automatically by every workspace tool.
# Alternatively, put only VITE_* values in apps/web/.env.local for Vite.

# Web app. VITE_* values are public and must never contain secrets.
# Empty uses same-origin /trpc, proxied to localhost:8787 during dev/preview.
# Production builds use https://calwise-api.lastlab.win.
VITE_API_URL=
# Optional branding override: dev or production. Leave unset to follow Vite mode.
# VITE_APP_VARIANT=dev

# Cloudflare deployment and Terraform provider credentials.
# Also configure these as GitHub repository secrets for deployments.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Terraform account input. Set to the same value as CLOUDFLARE_ACCOUNT_ID.
# The Infrastructure workflow maps this from the account ID repository secret.
TF_VAR_cloudflare_account_id=

# GitHub repository secrets for the R2 Terraform state bucket access key pair.
# The Infrastructure workflow maps these to AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Local Terraform S3 backend authentication for R2, not AWS credentials.
# Set to the same values as R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY respectively.
# See infra/backend.hcl.example for the R2 endpoint and backend configuration.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Automation-only flags. Leave unset for normal local development.
# Any nonempty CI value, including "false", enables Playwright's CI behavior.
# GitHub Actions sets CI automatically; the Infrastructure workflow sets TF_IN_AUTOMATION.
# CI=true
# TF_IN_AUTOMATION=true
